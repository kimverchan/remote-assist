<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootControl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:orientation="vertical">

    <!-- 顶部栏的实际位置由 ControlActivity 的 WindowInsets 处理：
         整个界面会避开系统状态栏 / 刘海 / 手势条，避免「断开」被状态栏挡住 -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="#182029"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/status_idle"
            android:textColor="#E6F1FB"
            android:textSize="13sp" />

        <!-- 48dp 高 + 88dp 宽：满足最小触摸目标，且与状态文字、屏幕边缘留足间距 -->
        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="88dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:backgroundTint="#B3261E"
            android:textColor="#FFFFFF"
            android:text="@string/btn_disconnect" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/frameScreen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <TextureView
            android:id="@+id/textureScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/btn_back"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/btn_home"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRecents"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/btn_recents"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/btn_text"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
