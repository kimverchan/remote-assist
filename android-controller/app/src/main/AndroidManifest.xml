<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 明文 HTTP 仅由 src/debug/AndroidManifest.xml 为调试包开启；release 默认禁止 -->
    <application
        android:name=".RemoteControllerApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_stat_remote"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RemoteAssist">

        <activity
            android:name=".ui.PairingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ControlActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:keepScreenOn="true" />
    </application>
</manifest>
