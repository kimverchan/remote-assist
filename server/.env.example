# 复制到 server/.env；仅占位值
NODE_ENV=development
# 代码默认 3000（与容器/部署平台对齐）；本地开发可显式设为 8080
PORT=8080
HOST=0.0.0.0
JWT_SECRET=replace_with_at_least_32_random_characters_here
ADMIN_API_KEY=replace_with_a_random_admin_key
JWT_ACCESS_TTL=900
REFRESH_TTL=86400
SESSION_TTL=3600
MAX_SESSIONS=200
HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_TIMEOUT_MS=30000
PEER_RECONNECT_GRACE_MS=30000
MAX_FRAME_BYTES=524288
MAX_TEXT_BYTES=16384
MAX_FRAMES_PER_SECOND=60
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 仅在「容器端口不对外暴露 + 边缘反代覆盖 X-Forwarded-For」时设为 true
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
# 设备凭据（App 自动生成设备号 + 6 位密码并注册，服务端只存摘要）
DEVICE_DATA_DIR=./data
DEVICE_LOCK_THRESHOLD=5
DEVICE_LOCK_MINUTES=15
TEMP_PASSWORD_MAX_MINUTES=120
