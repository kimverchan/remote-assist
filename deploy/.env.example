# 生产环境变量模板 —— 复制为 .env 后填写，或直接运行 `bash deploy.sh <域名>` 自动生成。
# 本文件只含占位值；真实 .env 含密钥，已被 .gitignore 排除，务必 chmod 600 并离线备份。

# 已解析到本机公网 IP 的域名（两端 App 首页填 https://<这个域名>）
RELAY_DOMAIN=relay.example.com
# Let's Encrypt 证书到期提醒邮箱
CADDY_EMAIL=admin@example.com
# relay 容器绑定在 127.0.0.1 的端口，仅用于本机排查；公网不要放行此端口
RELAY_PORT=3000

# 必填强随机值：openssl rand -hex 32 / openssl rand -hex 24
# 更换这两个值会让所有已签发令牌立即失效，部署后请保持不变
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32_OUTPUT_AT_LEAST_32_CHARS
ADMIN_API_KEY=REPLACE_WITH_openssl_rand_hex_24_OUTPUT_AT_LEAST_16_CHARS

# 仅一层反代（Caddy → relay）。Caddyfile 已强制覆盖 X-Forwarded-For，故可安全开启
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# 只填 Web 运维看板的源；Android 原生请求不受 CORS 限制
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# 单个 WebSocket 帧上限（字节）；默认 512 KB，与编码器 2 Mbps / 1280 长边匹配
MAX_FRAME_BYTES=524288
# 每 IP 每 60s 请求数上限
RATE_LIMIT_MAX=60

# 设备凭据（受控端 App 自动生成 9 位设备号 + 6 位数字密码，首次建会话自动注册到服务端）
# 服务端只存 peppered 摘要（用 JWT_SECRET 派生），不存明文密码，无需在此配置设备清单。
DEVICE_DATA_DIR=/app/data
# 连续密码错误达到该次数后锁定设备
DEVICE_LOCK_THRESHOLD=5
# 锁定时长（分钟）
DEVICE_LOCK_MINUTES=15
# 临时密码最长有效期（分钟）
TEMP_PASSWORD_MAX_MINUTES=120
