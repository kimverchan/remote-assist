# 复制到 server/.env 后按实际环境修改；本文件只含占位值，切勿提交真实密钥
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# 必填，至少 32 字符。生产用 `openssl rand -hex 32` 生成
JWT_SECRET=replace_with_at_least_32_random_characters_here
ADMIN_API_KEY=replace_with_a_random_admin_key

JWT_ACCESS_TTL=900
REFRESH_TTL=86400
PAIRING_CODE_TTL=60
PAIRING_MAX_ATTEMPTS=5
SESSION_TTL=3600
MAX_SESSIONS=200

HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_TIMEOUT_MS=30000
PEER_RECONNECT_GRACE_MS=30000

MAX_FRAME_BYTES=524288
MAX_TEXT_BYTES=16384
MAX_FRAMES_PER_SECOND=60

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# 逗号分隔的显式白名单，生产禁用通配符
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 仅在「容器端口不对外暴露 + 边缘反代覆盖 X-Forwarded-For」时设为 true。
# 直连或反代会透传客户端 XFF 时保持 false，否则限流可被伪造请求头绕过。
TRUST_PROXY=false
# 启用 TRUST_PROXY 时可信的代理跳数，通常 1（只有一层反代）
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# 设备凭据（受控端 App 自动生成 9 位设备号 + 6 位数字密码，首次建会话自动注册）
# 服务端只存 peppered 摘要，无需手工配置设备清单。
DEVICE_DATA_DIR=./data
# 连续密码错误锁定阈值与锁定时长（分钟）
DEVICE_LOCK_THRESHOLD=5
DEVICE_LOCK_MINUTES=15
# 临时密码最长有效期（分钟）
TEMP_PASSWORD_MAX_MINUTES=120
